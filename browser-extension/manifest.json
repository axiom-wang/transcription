{
  "manifest_version": 3,
  "name": "听记 · 标签页录音",
  "version": "0.1.0",
  "description": "独立录制多个标签页的音频，保存后可一键送入本机听记，完成转写、文稿优化和说话人区分。",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabCapture",
    "offscreen",
    "downloads",
    "tabs",
    "storage",
    "contextMenus",
    "sidePanel",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "src/sw/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "授权当前标签页并打开录制面板"
  },
  "side_panel": {
    "default_path": "src/ui/panel.html"
  },
  "commands": {
    "arm-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "授权当前标签页（加入录制列表）"
    },
    "toggle-record-all": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "开始 / 停止录制全部已授权标签页"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": ""
}
